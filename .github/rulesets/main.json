{
  "name": "main 保護：只經 PR 合併、必須通過 CI",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "~DEFAULT_BRANCH"
      ],
      "exclude": []
    }
  },
  "bypass_actors": [],
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": false,
        "allowed_merge_methods": [
          "merge"
        ]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "unit (ubuntu-latest, 22)",
            "integration_id": 15368
          },
          {
            "context": "unit (ubuntu-latest, 24)",
            "integration_id": 15368
          },
          {
            "context": "unit (windows-latest, 24)",
            "integration_id": 15368
          },
          {
            "context": "verify",
            "integration_id": 15368
          },
          {
            "context": "browser",
            "integration_id": 15368
          },
          {
            "context": "real-sdk (chatgpt)",
            "integration_id": 15368
          },
          {
            "context": "real-sdk (deepseek)",
            "integration_id": 15368
          },
          {
            "context": "real-sdk (gemini)",
            "integration_id": 15368
          },
          {
            "context": "real-sdk (glm)",
            "integration_id": 15368
          },
          {
            "context": "real-sdk (grok)",
            "integration_id": 15368
          }
        ]
      }
    }
  ]
}
