{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chinchiang/GartnerPreemptiveCybersecurity_Claude/skills/shared/output-schema.json",
  "title": "Preemptive Exposure Analysis — Output Bundle",
  "description": "六平臺共用的輸出格式。每個區塊都必須帶 confidence、basis、missing_inputs、requires_human。所有攻擊路徑的 status 固定為 hypothesis，除非另有已授權驗證結果；改成 validated-* 時必須附 evidence（authorization_reference、performed_at、result）。內容一致性（分數與分級、參照完整性、驗證證據）另由程式檢查。",
  "type": "object",
  "required": ["meta", "data_quality", "exposure_priorities", "attack_path_hypotheses", "remediation", "validation_plan", "executive_summary", "metrics", "human_review_points"],
  "$defs": {
    "confidence": { "type": "string", "enum": ["高", "中", "低"], "description": "資料齊備程度：只反映建議輸入是否齊全、資產清冊是否完整，不代表內容已經驗證、資料是新的或來源可信；「高」不等於已獲證實（舊稱「信心」，#152）。" },
    "priority": { "type": "string", "enum": ["P1", "P2", "P3", "P4"] },
    "block": {
      "type": "object",
      "required": ["confidence", "basis", "missing_inputs", "requires_human"],
      "properties": {
        "confidence": { "$ref": "#/$defs/confidence" },
        "basis": { "type": "string" },
        "missing_inputs": { "type": "array", "items": { "type": "string" } },
        "requires_human": { "type": "boolean" }
      }
    }
  },
  "properties": {
    "meta": {
      "type": "object",
      "required": ["organization", "analysis_date", "generated_by", "scope_reference", "scoring_rules", "disclaimer"],
      "properties": {
        "organization": { "type": "string" },
        "analysis_date": { "type": "string" },
        "generated_by": { "type": "string", "description": "平臺／模型名稱與 skill 版本" },
        "scope_reference": { "type": "string" },
        "scoring_rules": { "type": "string", "description": "實際使用的評分規則說明（預設為本專案附錄 A 示範規則）" },
        "disclaimer": { "type": "string", "minLength": 1, "description": "必須聲明：語言模型未驗證實際曝險；所有路徑為假設；主動測試需授權" }
      }
    },
    "data_quality": {
      "allOf": [{ "$ref": "#/$defs/block" }],
      "required": ["files"],
      "properties": {
        "files": { "type": "array", "items": { "type": "object", "required": ["name", "records", "missing_fields", "anomalies"], "description": "每個檔案都要回報；沒有缺欄位或異常時寫空陣列。", "properties": { "name": { "type": "string" }, "records": { "type": "integer" }, "missing_fields": { "type": "array", "items": { "type": "string" } }, "anomalies": { "type": "array", "items": { "type": "string" } } } } },
        "out_of_scope_excluded": { "type": "array", "items": { "type": "string" } },
        "inventory_completeness_estimate": { "type": ["number", "null"] }
      }
    },
    "exposure_priorities": {
      "allOf": [{ "$ref": "#/$defs/block" }],
      "required": ["items", "thresholds"],
      "properties": {
        "items": { "type": "array", "items": { "type": "object", "required": ["finding_id", "asset_id", "asset_name", "vuln_id", "priority", "score", "likelihood", "impact", "factors", "confidence"], "properties": { "finding_id": { "type": "string" }, "asset_id": { "type": "string" }, "asset_name": { "type": "string" }, "vuln_id": { "type": "string" }, "title": { "type": "string" }, "priority": { "$ref": "#/$defs/priority" }, "score": { "type": "number", "minimum": 0, "maximum": 100 }, "likelihood": { "type": "number", "minimum": 0, "maximum": 10 }, "impact": { "type": "number", "minimum": 0, "maximum": 10 }, "factors": { "type": "array", "items": { "type": "string" } }, "missing": { "type": "array", "items": { "type": "string" } }, "confidence": { "$ref": "#/$defs/confidence" } } } },
        "thresholds": { "type": "object", "description": "本次分級用的分數門檻：分數 ≥ P1 為 P1、≥ P2 為 P2、≥ P3 為 P3，其餘為 P4（依 scoring-rules.md 的風險胃納）。", "required": ["P1", "P2", "P3"], "properties": { "P1": { "type": "number" }, "P2": { "type": "number" }, "P3": { "type": "number" } } }
      }
    },
    "attack_path_hypotheses": {
      "allOf": [{ "$ref": "#/$defs/block" }],
      "required": ["items"],
      "properties": {
        "items": { "type": "array", "items": { "type": "object", "required": ["id", "entry", "target", "nodes", "edges", "feasibility", "blocking_controls", "status"], "properties": { "id": { "type": "string" }, "entry": { "type": "string" }, "target": { "type": "string" }, "nodes": { "type": "array", "items": { "type": "string" } }, "edges": { "type": "array", "items": { "type": "string" } }, "feasibility": { "type": "number", "minimum": 0, "maximum": 10 }, "blocking_controls": { "type": "array", "items": { "type": "string" } }, "status": { "type": "string", "enum": ["hypothesis", "validated-feasible", "validated-blocked"] }, "evidence": { "type": "object", "description": "status 不是 hypothesis 時必填：已授權驗證的證據。", "properties": { "authorization_reference": { "type": "string" }, "performed_at": { "type": "string" }, "result": { "type": "string" } } } } } }
      }
    },
    "remediation": {
      "allOf": [{ "$ref": "#/$defs/block" }],
      "required": ["items"],
      "properties": {
        "items": { "type": "array", "items": { "type": "object", "required": ["finding_id", "priority", "action", "owner", "effort", "verify", "approval_level"], "properties": { "finding_id": { "type": "string" }, "priority": { "$ref": "#/$defs/priority" }, "action": { "type": "string" }, "owner": { "type": "string" }, "effort": { "type": "string" }, "verify": { "type": "string" }, "approval_level": { "type": "string" } } } },
        "compensating_controls": { "type": "array", "items": { "type": "object", "properties": { "control": { "type": "string" }, "gaps": { "type": "string" }, "note": { "type": "string" } } } }
      }
    },
    "validation_plan": {
      "allOf": [{ "$ref": "#/$defs/block" }],
      "required": ["items"],
      "properties": {
        "items": { "type": "array", "items": { "type": "object", "required": ["id", "hypothesis", "method", "authorization_required", "authorization_status", "scope_exclusions", "success_criteria"], "properties": { "id": { "type": "string" }, "hypothesis": { "type": "string" }, "method": { "type": "string" }, "authorization_required": { "type": "string", "description": "需要誰的書面授權，例如「需 CISO 書面核准」" }, "authorization_status": { "type": "string", "enum": ["尚未授權主動測試", "已授權"], "description": "scope 的兩個授權旗標任一為 false 時填「尚未授權主動測試」；涉及對外驗證的項目，兩個旗標都是 true 才可以填「已授權」" }, "scope_exclusions": { "type": "array", "items": { "type": "string" } }, "success_criteria": { "type": "string" } } } }
      }
    },
    "executive_summary": {
      "allOf": [{ "$ref": "#/$defs/block" }],
      "required": ["text"],
      "properties": { "audience": { "type": "array", "items": { "type": "string" } }, "text": { "type": "string", "maxLength": 300, "description": "正文 ≤ 300 字（含標點；對象／日期列另放 audience 與 meta）。正文本身要寫出限制與「所有路徑為假設」；帳號、IP、主機名稱整段遮罩，不保留網段、前綴或部分字元" }, "decisions_requested": { "type": "array", "items": { "type": "string" } } }
    },
    "metrics": {
      "allOf": [{ "$ref": "#/$defs/block" }],
      "required": ["items"],
      "properties": { "items": { "type": "array", "minItems": 6, "items": { "type": "object", "required": ["name", "value", "target", "next_review"], "properties": { "name": { "type": "string" }, "value": {}, "target": { "type": "string" }, "next_review": { "type": "string" } } } } }
    },
    "human_review_points": {
      "type": "array",
      "items": { "type": "object", "required": ["stage", "who", "what"], "properties": { "stage": { "type": "string" }, "who": { "type": "string" }, "what": { "type": "string" }, "status": { "type": "string", "enum": ["pending", "approved", "rejected"] } } }
    }
  }
}
