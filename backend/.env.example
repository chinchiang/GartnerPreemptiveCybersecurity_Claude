# 範例：不要把真實值寫進任何會提交的檔案。Cloudflare 以 `wrangler secret put PROVIDER_API_KEY` 設定。
PROVIDER=openai            # 選用，預設 openai；其他值要設 BASE_URL。openai | anthropic | xai | glm | deepseek | gemini（gemini 的 OpenAI 相容端點官方標示 beta）
MODEL=gpt-6-astra          # 必填；以供應商官方模型列表為準
PROVIDER_API_KEY=          # 必填；僅在伺服器端設定
ALLOWED_ORIGIN=https://chinchiang.github.io   # 必填；沒設定時所有請求都回 500
BASE_URL=                  # 選用：覆寫預設端點
MAX_OUTPUT_TOKENS=8000     # 選用：每次呼叫的輸出 token 上限，正整數，預設 8000；留空等於沒設定
UPSTREAM_TIMEOUT_MS=60000  # 選用：上游逾時（毫秒），正整數、最大 2147483647，預設 60000；留空等於沒設定；逾時回 504
