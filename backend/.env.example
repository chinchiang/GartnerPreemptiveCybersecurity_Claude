# 範例：不要把真實值寫進任何會提交的檔案。Cloudflare 以 `wrangler secret put PROVIDER_API_KEY` 設定。
PROVIDER=openai            # openai | anthropic | xai | glm | deepseek
MODEL=gpt-5.5              # 以供應商官方模型列表為準
PROVIDER_API_KEY=          # 僅在伺服器端設定
ALLOWED_ORIGIN=https://chinchiang.github.io
BASE_URL=                  # 選用：覆寫預設端點
